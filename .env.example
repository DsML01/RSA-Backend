# Configurações do Banco de Dados SQLite (ou outro provedor suportado pelo SQLAlchemy)
DATABASE_URL=sqlite:////data/rsa_project.db

# Chave secreta para geração dos tokens JWT (gere uma string segura em produção)
SECRET_KEY=change-this-to-a-very-secure-secret-key-in-production

# Origens permitidas para CORS (separadas por vírgula)
# Adicione a URL do seu frontend na Vercel e o localhost para desenvolvimento
CORS_ORIGINS=http://localhost:5173,https://seu-frontend.vercel.app

# Diretório para armazenamento dos arquivos ZIP e códigos submetidos
UPLOAD_DIR=/data/uploads
